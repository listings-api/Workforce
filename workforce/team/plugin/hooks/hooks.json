{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{python_quoted}} -m workforce.team.hooks pretooluse",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{python_quoted}} -m workforce.team.hooks userpromptsubmit",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
